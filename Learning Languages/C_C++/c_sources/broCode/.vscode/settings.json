{
    
    // Visual Studio Code COZY settings UwU ☺️
    // Made by Fatin Ilham 👋 (https://github.com/iamfatinilham/baby-learning-codes)
    
    
    //Indentation & File Basics
    "files.eol": "\n",
    "editor.tabSize": 4,
    "editor.indentSize": "tabSize",
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "update.showReleaseNotes": false,
    
    
    // UI & Workbench
    "security.workspace.trust.enabled": false,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Consolas, 'Courier New', monospace", // Jetbrains Mono font: https://www.jetbrains.com/mono
    "editor.fontLigatures": true,
    "workbench.colorTheme": "Aura Dark",
    "workbench.iconTheme": "vscode-icons",
    
    "workbench.colorCustomizations": {
        "[Aura Dark]": {
            "editor.selectionBackground": "#4d385d",
            "editor.selectionHighlightBackground": "#4c3b5bbd",
            "terminal.selectionBackground": "#4c3e51",
            "editor.findMatchBackground": "#9649d44f",
            "editor.findMatchHighlightBackground": "#a02dff65",
        },
    },
    
    "editor.renderWhitespace": "trailing",
    "workbench.editor.showTabs": "multiple",
    "editor.bracketPairColorization.enabled": true,
    "editor.fontSize": 16,
    "workbench.startupEditor": "none",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "chat.disableAIFeatures": true,
    "explorer.compactFolders": false,
    "explorer.sortOrder": "type",
    "scm.compactFolders": false,
    "scm.inputFontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Consolas, 'Courier New', monospace",
    
    
    // Editor Behavior
    "editor.smoothScrolling": true,
    //"editor.minimap.renderCharacters": false,
    "files.autoSave": "afterDelay",
    "editor.formatOnSave": true,
    "files.autoSaveDelay": 1000,
    "editor.mouseWheelZoom": true,
    "editor.cursorWidth": 2,
    "editor.guides.highlightActiveIndentation": "always",
    "editor.renderFinalNewline": "dimmed",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "expand",
    "search.showLineNumbers": true,
    
    "files.exclude": {
        
        // OS & Version Control Internals
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.log": true,
        
        // JavaScript / TypeScript / Web
        "**/node_modules/**": true,
        "**/node_modules": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/.svelte-kit": true,
        "**/.turbo": true,
        "**/.parcel-cache": true,
        "**/dist": true,
        
        // Python
        "**/__pycache__": true,
        "**/*.py[cod]": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/*.egg-info": true,
        
        // C / C++
        "**/*.o": true,
        "**/*.obj": true,
        "**/*.a": true,
        "**/*.lib": true,
        "**/*.so": true,
        "**/*.dylib": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.out": true,
        "**/*.pdb": true,
        "**/*.ilk": true,
        "**/CMakeFiles": true,
        "**/CMakeCache.txt": true,
        
        // C# / .NET
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.nupkg": true,
        
        // Java / JVM
        "**/*.class": true,
        "**/.gradle": true,
        "**/.settings": true,
        "**/.classpath": true,
        "**/.project": true,
        
        // Rust & Go
        "**/*.rlib": true,
        "**/*.rmeta": true,
        "**/*.test": true
    },
    
    "search.exclude": {
        
        // VS Code Defaults
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/build/**": true,
        
        // JavaScript / TypeScript Lockfiles & Minified Assets
        "**/package-lock.json": true,
        "**/yarn.lock": true,
        "**/pnpm-lock.yaml": true,
        "**/bun.lockb": true,
        "**/*.min.js": true,
        "**/*.min.css": true,
        "**/*.map": true,
        "**/*.chunk.js": true,
        
        // Python Virtual Environments & Lockfiles
        "**/.venv": true,
        "**/venv": true,
        "**/poetry.lock": true,
        "**/Pipfile.lock": true,
        "**/uv.lock": true,
        
        // Rust & Go Lockfiles
        "**/Cargo.lock": true,
        "**/go.sum": true,
        
        // Java Archives
        "**/*.jar": true,
        "**/*.war": true,
        "**/*.ear": true
    },
    
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        //"https://raw.githubusercontent.com/catppuccin": true,
        "https://raw.githubusercontent.com/catppuccin/vscode": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://spec.openapis.org/": true,
        "https://www.schemastore.org/": true
    },
    
    
    // Networking
    "network.meteredConnection": "off",
    
    
    // Git & Terminal
    //"terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', 'JetBrains Mono', Consolas, 'Courier New', monospace",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorWidth": 3,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "git.path": "C:/Program Files/Git/cmd/git.exe", // Windows specific
    
    // Windows specific setting
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
        },
        "Command Prompt": {
            "path": "C:/Windows/System32/cmd.exe",
            "args": [],
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash",
        },
    },
    
    
    // Markdown Settings
    "[markdown]": {
        "editor.wordWrap": "off",
    },

    // JSON File Settings
    "[json]": {
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
    },

    // JSONC File Settings
    "[jsonc]": {
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
    },


    // C/C++ Settings
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64", // Windows specific
    "C_Cpp.default.compilerPath": "C:/mingw64/bin/gcc.exe", // Windows specific
    "C_Cpp.default.cStandard": "c23",
    "C_Cpp.default.cppStandard": "c++26",
    "C_Cpp_Runner.cCompilerPath": "gcc",
    "C_Cpp_Runner.cppCompilerPath": "g++",
    "C_Cpp_Runner.debuggerPath": "gdb",
    "C_Cpp_Runner.useMsvc": false,
    //"C_Cpp.intelliSenseUpdateDelay": 500,
    //"C_Cpp.codeAnalysis.clangTidy.enabled": true,
    //"C_Cpp.codeAnalysis.runAutomatically": true,
    //"C_Cpp.markdownInComments": "enabled",
    "C_Cpp.inlayHints.autoDeclarationTypes.enabled": true,
    "C_Cpp.inlayHints.parameterNames.enabled": true,
    "C_Cpp.inlayHints.referenceOperator.enabled": true,
    "C_Cpp.inlayHints.parameterNames.suppressWhenArgumentContainsName": false,
    //"C_Cpp_Runner.msvcBatchPath": "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Auxiliary/Build/vcvarsall.bat",
    
    "cmake.additionalCompilerSearchDirs": [
        "C:/mingw64/bin/",
        "C:/Program Files/LLVM/bin",
    ],
    
    "C_Cpp.default.defines": [
        "_DEBUG",
        "UNICODE",
        "_UNICODE"
    ],
    
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "C:/mingw64/x86_64-w64-mingw32/include",
        "C:/mingw64/include/c++"
    ],

    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
    },
    
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
    },
    
    //"C_Cpp.default.compileCommands": [
    //],
    
    
    // Python Settings
    "python.languageServer": "Pylance",
    "python.experiments.enabled": false,
    //"python.analysis.languageServerMode": "default",
    //"python.analysis.autoImportCompletions": true,
    //"python.analysis.typeCheckingMode": "standard",
    //"python.analysis.diagnosticSeverityOverrides": {
    //    "reportGeneralTypeIssues": "none",
    //},
    
    
    // Rust-analyzer Extension settings
    "rust-analyzer.check.command": "clippy",
    
    
    // TODO tree Extension settings
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)|todo!",
    
    
    // Code Runner Extension settings
    "code-runner.clearPreviousOutput": true,
    "code-runner.preserveFocus": true,
    "code-runner.respectShebang": true,
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,
    
    
    // Code Runner: Executor Map
    // Windows specific
    "code-runner.executorMap": {
        "javascript": "node",
        "java": "clear && cd $dir && mkdir output -Force | Out-Null && javac -d output $fileName && java -cp output $fileNameWithoutExt",
        "c": "clear && cd $dir && mkdir output -Force | Out-Null && gcc -std=c23 -g $fileName -o output/$fileNameWithoutExt && clear && ./output/$fileNameWithoutExt.exe",
        "cpp": "clear && cd $dir && mkdir output -Force | Out-Null && g++ -std=c++26 -g $fileName -o output/$fileNameWithoutExt && clear && ./output/$fileNameWithoutExt.exe",
        "zig": "zig run",
        "objective-c": "clear && cd $dir && mkdir output -Force | Out-Null && gcc -framework Cocoa $fileName -o output/$fileNameWithoutExt && clear && ./output/$fileNameWithoutExt.exe",
        "php": "php",
        "python": "clear && cd $dir && python -u $fileName",
        "perl": "perl",
        "perl6": "perl6",
        "ruby": "ruby",
        "go": "clear && cd $dir && mkdir output -Force | Out-Null && go build -o output/$fileNameWithoutExt.exe $fileName && clear && ./output/$fileNameWithoutExt.exe",
        "lua": "lua",
        "groovy": "groovy",
        "powershell": "clear && cd $dir && powershell -ExecutionPolicy ByPass -File $fileName",
        "bat": "cmd /c $fileName",
        "shellscript": "clear && bash -x $fileName",
        "fsharp": "fsi",
        "csharp": "scriptcs",
        "vbscript": "cscript //Nologo",
        "typescript": "ts-node",
        "coffeescript": "coffee",
        "scala": "scala",
        "swift": "swift",
        "julia": "julia",
        "crystal": "crystal",
        "ocaml": "ocaml",
        "r": "Rscript",
        "applescript": "osascript",
        "clojure": "lein exec",
        "haxe": "haxe --cwd $dirWithoutTrailingSlash --run $fileNameWithoutExt",
        "rust": "cd $dir && mkdir output -Force | Out-Null && rustc $fileName -o output/$fileNameWithoutExt.exe && clear && ./output/$fileNameWithoutExt.exe",
        "racket": "racket",
        "scheme": "csi -script",
        "ahk": "autohotkey",
        "autoit": "autoit3",
        "dart": "clear && dart",
        "pascal": "cd $dir && mkdir output -Force | Out-Null && fpc -FEoutput $fileName && clear && ./output/$fileNameWithoutExt.exe",
        "d": "cd $dir && mkdir output -Force | Out-Null && dmd -od=output -of=output/$fileNameWithoutExt $fileName && clear && clear && ./output/$fileNameWithoutExt.exe",
        "haskell": "runghc",
        "nim": "nim compile --verbosity:0 --hints:off --run",
        "lisp": "sbcl --script",
        "kit": "kitc --run",
        "v": "v run",
        "sass": "sass --style expanded",
        "scss": "scss --style expanded",
        "less": "cd $dir && mkdir output -Force | Out-Null && lessc $fileName output/$fileNameWithoutExt.css",
        "FortranFreeForm": "cd $dir && mkdir output -Force | Out-Null && gfortran $fileName -o output/$fileNameWithoutExt && clear && ./output/$fileNameWithoutExt.exe",
        "fortran-modern": "cd $dir && mkdir output -Force | Out-Null && gfortran $fileName -o output/$fileNameWithoutExt && clear && ./output/$fileNameWithoutExt.exe",
        "fortran_fixed-form": "cd $dir && mkdir output -Force | Out-Null && gfortran $fileName -o output/$fileNameWithoutExt && clear && ./output/$fileNameWithoutExt.exe",
        "fortran": "cd $dir && mkdir output -Force | Out-Null && gfortran $fileName -o output/$fileNameWithoutExt && clear && ./output/$fileNameWithoutExt.exe",
        "sml": "cd $dir && sml $fileName",
        "mojo": "mojo run",
        "erlang": "escript",
        "spwn": "spwn build",
        "pkl": "cd $dir && mkdir output -Force | Out-Null && pkl eval -f yaml $fileName -o output/$fileNameWithoutExt.yaml",
        "gleam": "gleam run -m $fileNameWithoutExt",
    },


